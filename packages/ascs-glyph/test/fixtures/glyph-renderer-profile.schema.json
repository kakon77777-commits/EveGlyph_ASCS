{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.example/schemas/glyph-renderer-profile.schema.json",
  "type": "object",
  "required": [
    "profile",
    "renderer_id",
    "version",
    "input_representations",
    "target",
    "fidelity",
    "deterministic",
    "fallback"
  ],
  "properties": {
    "profile": {
      "const": "glyph-renderer/1.0-candidate.1"
    },
    "renderer_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "input_representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "target": {
      "enum": [
        "svg",
        "canvas2d",
        "raster",
        "opentype-outline",
        "opentype-colr",
        "opentype-svg",
        "gpu-mesh",
        "accessibility-tree",
        "debug-structure"
      ]
    },
    "fidelity": {
      "enum": [
        "exact",
        "structural",
        "visual",
        "lossy",
        "unknown"
      ]
    },
    "deterministic": {
      "type": "boolean"
    },
    "fallback": {
      "enum": [
        "reject",
        "use-exact-carry",
        "use-structural",
        "use-debug",
        "renderer-defined"
      ]
    }
  },
  "additionalProperties": false
}
