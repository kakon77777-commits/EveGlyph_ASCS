{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eveglyph.local/v0.7/agent-principal.schema.json",
  "title": "Agent Principal v1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "principal_id",
    "principal_class",
    "identity_scope",
    "label",
    "controller",
    "created_at",
    "metadata"
  ],
  "properties": {
    "profile": {
      "const": "agent-principal/1.0-candidate.1"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
    },
    "principal_class": {
      "enum": [
        "ai-agent",
        "automation",
        "hybrid-agent"
      ]
    },
    "identity_scope": {
      "enum": [
        "workspace",
        "installation",
        "federated",
        "ephemeral"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "organization",
            "system"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "default_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
